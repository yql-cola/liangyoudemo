# Copy to .env and replace every example value before running Docker Compose.
MINIO_ROOT_USER=replace-with-admin-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_APP_ACCESS_KEY=replace-with-app-access-key
MINIO_APP_SECRET_KEY=replace-with-another-long-random-password
MINIO_DATA_DIR=/absolute/path/to/persistent/minio-data
